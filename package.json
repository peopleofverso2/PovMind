{
  "name": "povmind",
  "version": "0.4.1",
  "private": true,
  "description": "PovMind static vault app served for Cloud Run.",
  "scripts": {
    "start": "node server.js",
    "sync:version": "node scripts/sync-version.mjs",
    "check": "node --check server.js && node --check app.js",
    "smoke": "node --check server.js && node --check app.js",
    "verify:online": "node scripts/verify-online.mjs",
    "deploy:gcp": "node scripts/deploy-gcp.mjs",
    "repo:manifest": "node scripts/repo-manifest.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
